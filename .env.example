# Use the same Google OAuth Web Client ID in both places.
# Frontend (Vite / Netlify):
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Backend/PHP API validation:
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Google Calendar server (local only):
CLIENT_ID=your-google-oauth-client-id
SECRET_ID=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CALENDAR_PORT=3001
VITE_API_URL=http://localhost/H-A-Cozy-Pad/api